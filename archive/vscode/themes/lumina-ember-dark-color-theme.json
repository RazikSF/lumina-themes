      ],
      "settings": {
        "foreground": "#DC5C48"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#DC5C48",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
