    },
    "type": {
      "foreground": "#2E7A56",
      "fontStyle": "italic"
    },
    "namespace": {
      "foreground": "#2E7A56"
    },
    "macro": {
      "foreground": "#93621A"
    },
    "keyword": {
      "foreground": "#93621A",
      "fontStyle": "bold"
    },
    "string": {
      "foreground": "#1A6675"
