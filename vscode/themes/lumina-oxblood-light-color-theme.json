      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2E7A56"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B23036"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#93621A"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#B23036"
      }
    }
