    },
    "type": {
      "foreground": "#79B98A",
      "fontStyle": "italic"
    },
    "namespace": {
      "foreground": "#79B98A"
    },
    "macro": {
      "foreground": "#D8B45E"
    },
    "keyword": {
      "foreground": "#D8B45E",
