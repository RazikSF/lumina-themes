    },
    "type": {
      "foreground": "#6FB0BE",
      "fontStyle": "italic"
    },
    "namespace": {
      "foreground": "#6FB0BE"
    },
    "macro": {
      "foreground": "#6FA6D6"
    },
    "keyword": {
      "foreground": "#6FA6D6",
      "fontStyle": "bold"
    },
    "string": {
      "foreground": "#88B596"
    },
    "number": {
      "foreground": "#CCA074"
