  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#79705F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#2E7D4F"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B0532A"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#8A3F73"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#B0532A"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#8A3F73",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#4B4FBF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#6E665A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#1F6FB5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#9A6B16",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#46413A"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2B2A28",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#8A3F73",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8A3F73"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#4B4FBF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9A6B16"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.preprocessor"
      ],
      "settings": {
        "foreground": "#4B4FBF"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#5C574F"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#4B4FBF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#1F6FB5"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2E7D4F"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#BE2F33"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#9A6B16"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#BE2F33"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#9A6B16"
    },
    "function": {
      "foreground": "#1F6FB5"
    },
    "method": {
      "foreground": "#1F6FB5"
    },
    "variable": {
      "foreground": "#46413A"
    },
    "parameter": {
      "foreground": "#2B2A28",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#1B6E86"
    },
    "enumMember": {
      "foreground": "#8A3F73"
    },
    "type": {
      "foreground": "#9A6B16",
      "fontStyle": "italic"
    },
    "namespace": {
      "foreground": "#9A6B16"
    },
    "macro": {
      "foreground": "#4B4FBF"
    },
    "keyword": {
      "foreground": "#4B4FBF",
      "fontStyle": "bold"
    },
    "string": {
      "foreground": "#2E7D4F"
    },
    "number": {
      "foreground": "#B0532A"
    },
    "operator": {
      "foreground": "#6E665A"
    },
    "comment": {
      "foreground": "#79705F",
      "fontStyle": "italic"
    }
  }
}
