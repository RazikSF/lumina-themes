      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#82BE7A"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E0705A"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#DDB45E"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E0705A"
      }
    }
