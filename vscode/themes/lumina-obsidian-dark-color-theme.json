        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D7D7DA"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D7D7DA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.constant"
      ],
