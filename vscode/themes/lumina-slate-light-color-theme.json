        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9E5A28"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#4A4694",
        "fontStyle": "bold"
      }
    },
    {
