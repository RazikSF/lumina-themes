        "foreground": "#1C7A56"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B83048"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8A6512"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#B83048"
      }
    }
