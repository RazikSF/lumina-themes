        "foreground": "#46BAB4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#54C194",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#C8CBDC"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#DEE0EC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.constant"
      ],
      "settings": {
