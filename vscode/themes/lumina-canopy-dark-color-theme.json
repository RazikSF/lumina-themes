    },
    "parameter": {
      "foreground": "#D8E6CE",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#7CB377"
    },
    "enumMember": {
      "foreground": "#9A8ED0"
    },
    "type": {
      "foreground": "#DD9A5A",
      "fontStyle": "italic"
    },
    "namespace": {
      "foreground": "#DD9A5A"
    },
    "macro": {
      "foreground": "#D6B25C"
    },
    "keyword": {
      "foreground": "#D6B25C",
      "fontStyle": "bold"
    },
    "string": {
      "foreground": "#7CB377"
    },
    "number": {
      "foreground": "#DD9A5A"
    },
    "operator": {
      "foreground": "#6E8C70"
