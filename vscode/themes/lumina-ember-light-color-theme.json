  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#897C68",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#2E7A45"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A85410"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#8E3F66"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#B53A2E"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#8A6310",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#A85410",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1A6678"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#245F9E"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#1A7468",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#463F34"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2A2620",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#8A6310",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8A6310"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A85410"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8A6310"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.preprocessor"
      ],
      "settings": {
        "foreground": "#A85410"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#5C5448"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#A85410",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#245F9E"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2E7A45"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B53A2E"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8A6310"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#B53A2E"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#1A7468"
    },
    "function": {
      "foreground": "#245F9E"
    },
    "method": {
      "foreground": "#245F9E"
    },
    "variable": {
      "foreground": "#463F34"
    },
    "parameter": {
      "foreground": "#2A2620",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#1A7468"
    },
    "enumMember": {
      "foreground": "#8A6310"
    },
    "type": {
      "foreground": "#1A7468",
      "fontStyle": "italic"
    },
    "namespace": {
      "foreground": "#1A7468"
    },
    "macro": {
      "foreground": "#A85410"
    },
    "keyword": {
      "foreground": "#A85410",
      "fontStyle": "bold"
    },
    "string": {
      "foreground": "#2E7A45"
    },
    "number": {
      "foreground": "#B53A2E"
    },
    "operator": {
      "foreground": "#1A6678"
    },
    "comment": {
      "foreground": "#897C68",
      "fontStyle": "italic"
    }
  }
