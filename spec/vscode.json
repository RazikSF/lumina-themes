{
  "_schema": "VS Code declarative theme. 'colors' = workbench colors (string ref or 'name@AA' for 8-digit hex with alpha). 'tokenColors' = TextMate scope rules (fg ref + fontStyle literal). 'semanticTokenColors' = semantic role -> {fg ref, fontStyle literal}.",

  "colors": {
    "foreground":                                "fg",
    "focusBorder":                               "schema.lead",
    "errorForeground":                           "red",
    "descriptionForeground":                     "base5",
    "icon.foreground":                           "fg-alt",
    "editor.background":                         "bg",
    "editor.foreground":                         "fg",
    "editorCursor.foreground":                   "schema.lead",
    "editor.lineHighlightBackground":            "base1",
    "editor.selectionBackground":                "region",
    "editor.inactiveSelectionBackground":        "base2",
    "editor.findMatchBackground":                "yellow@55",
    "editor.findMatchHighlightBackground":       "yellow@33",
    "editor.wordHighlightBackground":            "base2",
    "editor.wordHighlightStrongBackground":      "base3",
    "editor.hoverHighlightBackground":           "base2",
    "editorLineNumber.foreground":               "base4",
    "editorLineNumber.activeForeground":         "schema.lead",
    "editorIndentGuide.background1":             "base2",
    "editorIndentGuide.activeBackground1":       "base4",
    "editorBracketMatch.background":             "base3",
    "editorBracketMatch.border":                 "schema.lead",
    "editorWhitespace.foreground":               "base3",
    "editorRuler.foreground":                    "base3",
    "activityBar.background":                    "bg-alt",
    "activityBar.foreground":                    "schema.lead",
    "activityBar.inactiveForeground":            "base5",
    "activityBar.border":                        "bg-alt",
    "activityBarBadge.background":               "schema.lead",
    "activityBarBadge.foreground":               "bg",
    "sideBar.background":                        "bg-alt",
    "sideBar.foreground":                        "fg-alt",
    "sideBar.border":                            "bg-alt",
    "sideBarTitle.foreground":                   "fg",
    "sideBarSectionHeader.background":           "base1",
    "sideBarSectionHeader.foreground":           "fg-alt",
    "statusBar.background":                      "schema.modeline_bg",
    "statusBar.foreground":                      "fg-alt",
    "statusBar.border":                          "schema.modeline_bg",
    "statusBar.debuggingBackground":             "orange",
    "statusBar.debuggingForeground":             "bg",
    "statusBar.noFolderBackground":              "schema.modeline_bg",
    "statusBarItem.hoverBackground":             "base2",
    "statusBarItem.remoteBackground":            "schema.lead",
    "statusBarItem.remoteForeground":            "bg",
    "tab.activeBackground":                      "bg",
    "tab.activeForeground":                      "schema.lead",
    "tab.activeBorderTop":                       "schema.lead",
    "tab.inactiveBackground":                    "bg-alt",
    "tab.inactiveForeground":                    "base5",
    "tab.border":                                "bg-alt",
    "tab.hoverBackground":                       "base1",
    "tab.unfocusedActiveForeground":             "fg-alt",
    "editorGroupHeader.tabsBackground":          "bg-alt",
    "editorGroupHeader.tabsBorder":              "bg-alt",
    "editorGroup.border":                        "base2",
    "panel.background":                          "bg",
    "panel.border":                              "base2",
    "panelTitle.activeForeground":               "schema.lead",
    "panelTitle.activeBorder":                   "schema.lead",
    "panelTitle.inactiveForeground":             "base5",
    "input.background":                          "base1",
    "input.foreground":                          "fg",
    "input.border":                              "base3",
    "input.placeholderForeground":               "base5",
    "inputOption.activeBackground":              "base3",
    "inputOption.activeBorder":                  "schema.lead",
    "dropdown.background":                       "base1",
    "dropdown.foreground":                       "fg",
    "dropdown.border":                           "base3",
    "list.activeSelectionBackground":            "base2",
    "list.activeSelectionForeground":            "schema.lead",
    "list.inactiveSelectionBackground":          "base1",
    "list.inactiveSelectionForeground":          "fg",
    "list.hoverBackground":                      "base1",
    "list.hoverForeground":                      "fg",
    "list.focusBackground":                      "base2",
    "list.focusForeground":                      "schema.lead",
    "list.highlightForeground":                  "schema.lead",
    "scrollbar.shadow":                          "base0",
    "scrollbarSlider.background":                "base3@80",
    "scrollbarSlider.hoverBackground":           "base4@80",
    "scrollbarSlider.activeBackground":          "base4",
    "badge.background":                          "schema.lead",
    "badge.foreground":                          "bg",
    "button.background":                         "schema.lead",
    "button.foreground":                         "bg",
    "button.hoverBackground":                    "schema.lead",
    "diffEditor.insertedTextBackground":         "green@22",
    "diffEditor.removedTextBackground":          "red@22",
    "diffEditor.insertedLineBackground":         "green@15",
    "diffEditor.removedLineBackground":          "red@15",
    "gitDecoration.addedResourceForeground":     "green",
    "gitDecoration.modifiedResourceForeground":  "yellow",
    "gitDecoration.deletedResourceForeground":   "red",
    "gitDecoration.untrackedResourceForeground": "teal",
    "gitDecoration.ignoredResourceForeground":   "base5",
    "gitDecoration.conflictingResourceForeground": "orange",
    "peekView.border":                           "schema.lead",
    "peekViewEditor.background":                 "base0",
    "peekViewResult.background":                 "base1",
    "peekViewTitle.background":                  "base1",
    "peekViewTitleLabel.foreground":             "schema.lead",
    "notifications.background":                  "bg-alt",
    "notifications.foreground":                  "fg",
    "notifications.border":                      "base3",
    "terminal.background":                       "bg",
    "terminal.foreground":                       "fg",
    "terminalCursor.background":                 "bg",
    "terminalCursor.foreground":                 "schema.lead",
    "terminal.ansiBlack":                        "base1",
    "terminal.ansiRed":                          "red",
    "terminal.ansiGreen":                        "green",
    "terminal.ansiYellow":                       "yellow",
    "terminal.ansiBlue":                         "blue",
    "terminal.ansiMagenta":                      "magenta",
    "terminal.ansiCyan":                         "cyan",
    "terminal.ansiWhite":                        "base7",
    "terminal.ansiBrightBlack":                  "base5",
    "terminal.ansiBrightRed":                    "orange",
    "terminal.ansiBrightGreen":                  "teal",
    "terminal.ansiBrightYellow":                 "yellow",
    "terminal.ansiBrightBlue":                   "dark-blue",
    "terminal.ansiBrightMagenta":                "violet",
    "terminal.ansiBrightCyan":                   "cyan",
    "terminal.ansiBrightWhite":                  "base8"
  },

  "tokenColors": [
    {"scope": ["comment", "punctuation.definition.comment"],
     "fg": "comments", "fontStyle": "italic"},
    {"scope": ["string", "string.quoted"],
     "fg": "strings"},
    {"scope": ["string.regexp"],
     "fg": "orange"},
    {"scope": ["constant.character.escape"],
     "fg": "schema.escape"},
    {"scope": ["constant.numeric"],
     "fg": "numbers"},
    {"scope": ["constant.language"],
     "fg": "constants", "fontStyle": "bold"},
    {"scope": ["keyword", "keyword.control", "storage.type.function"],
     "fg": "keywords", "fontStyle": "bold"},
    {"scope": ["keyword.operator"],
     "fg": "operators"},
    {"scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
     "fg": "functions"},
    {"scope": ["entity.name.type", "support.type", "support.class"],
     "fg": "type", "fontStyle": "italic"},
    {"scope": ["variable", "meta.definition.variable", "variable.other.readwrite"],
     "fg": "variables"},
    {"scope": ["variable.parameter"],
     "fg": "fg", "fontStyle": "italic"},
    {"scope": ["variable.language", "variable.other.constant"],
     "fg": "constants", "fontStyle": "bold"},
    {"scope": ["constant", "support.constant"],
     "fg": "constants"},
    {"scope": ["entity.name.tag"],
     "fg": "keywords"},
    {"scope": ["entity.other.attribute-name"],
     "fg": "yellow"},
    {"scope": ["meta.preprocessor", "keyword.preprocessor"],
     "fg": "schema.preprocessor"},
    {"scope": ["punctuation"],
     "fg": "fg-alt"},
    {"scope": ["markup.heading"],
     "fg": "schema.lead", "fontStyle": "bold"},
    {"scope": ["markup.bold"], "fontStyle": "bold"},
    {"scope": ["markup.italic"], "fontStyle": "italic"},
    {"scope": ["markup.underline.link"], "fg": "blue"},
    {"scope": ["markup.inserted"], "fg": "green"},
    {"scope": ["markup.deleted"], "fg": "red"},
    {"scope": ["markup.changed"], "fg": "yellow"},
    {"scope": ["invalid"], "fg": "red"}
  ],

  "semanticTokenColors": {
    "class":      {"fg": "type"},
    "function":   {"fg": "functions"},
    "method":     {"fg": "functions"},
    "variable":   {"fg": "variables"},
    "parameter":  {"fg": "fg", "fontStyle": "italic"},
    "property":   {"fg": "schema.property"},
    "enumMember": {"fg": "constants"},
    "type":       {"fg": "type", "fontStyle": "italic"},
    "namespace":  {"fg": "type"},
    "macro":      {"fg": "schema.preprocessor"},
    "keyword":    {"fg": "keywords", "fontStyle": "bold"},
    "string":     {"fg": "strings"},
    "number":     {"fg": "numbers"},
    "operator":   {"fg": "operators"},
    "comment":    {"fg": "comments", "fontStyle": "italic"}
  }
}
