    "regexp": {
      "foreground": "orange"
    },
    "escapeSequence": {
      "foreground": "schema.escape"
    },
    "formatSpecifier": {
      "foreground": "schema.escape"
    },
    "deprecated": {
      "strikethrough": true
    },
    "*.readonly": {
      "italic": true
    }
