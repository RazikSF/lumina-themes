    "type.defaultLibrary": {
      "foreground": "type",
      "italic": true
    },
    "typeParameter": {
      "foreground": "type",
      "italic": true
    },
    "keyword.control": {
      "foreground": "keywords",
      "bold": true
    },
    "boolean": {
      "foreground": "constants",
      "bold": true
    },
    "decorator": {
