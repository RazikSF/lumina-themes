  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "fg": "comments",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "fg": "strings"
    },
    {
      "scope": [
        "string.regexp"
      ],
      "fg": "orange"
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "fg": "schema.escape"
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "fg": "numbers"
    },
    {
      "scope": [
        "constant.language"
      ],
      "fg": "constants",
      "fontStyle": "bold"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type.function"
      ],
      "fg": "keywords",
      "fontStyle": "bold"
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "fg": "operators"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "fg": "functions"
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "fg": "type",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite"
      ],
      "fg": "variables"
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "fg": "fg",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "variable.language",
        "variable.other.constant"
      ],
      "fg": "constants",
      "fontStyle": "bold"
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "fg": "constants"
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "fg": "keywords"
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "fg": "yellow"
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.preprocessor"
      ],
      "fg": "schema.preprocessor"
    },
    {
      "scope": [
        "punctuation"
      ],
      "fg": "fg-alt"
    },
    {
      "scope": [
        "markup.heading"
      ],
      "fg": "schema.lead",
      "fontStyle": "bold"
    },
    {
      "scope": [
        "markup.bold"
      ],
      "fontStyle": "bold"
    },
    {
      "scope": [
        "markup.italic"
      ],
      "fontStyle": "italic"
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "fg": "blue"
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "fg": "green"
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "fg": "red"
    },
    {
      "scope": [
        "markup.changed"
      ],
      "fg": "yellow"
    },
    {
      "scope": [
        "invalid"
      ],
      "fg": "red"
    }
  ],
